    {
      "parameters": {
        "subject": "={{ `🚨 n8n Error Alert | ${$json.workflow_name}` }}",
        "message": "= {{ (() => {   const e = (v) => String(v ?? '')     .replace(/&/g, '&amp;')     .replace(/</g, '&lt;')     .replace(/>/g, '&gt;')     .replace(/\"/g, '&quot;')     .replace(/'/g, '&#39;');    return `   <div style=\"background:#f3f6fa;padding:25px;font-family:Arial,sans-serif;\">     <div style=\"max-width:600px;margin:auto;background:#fff;border-radius:12px;overflow:hidden;\">        <div style=\"background:#991b1b;color:white;padding:24px;\">         <h2 style=\"margin:0;\">Workflow Failure Alert</h2>         <p>Telecom AI Support — Error Monitoring</p>       </div>        <div style=\"padding:24px;color:#1e293b;\">         <p><strong>Workflow:</strong> ${e($json.workflow_name)}</p>         <p><strong>Failed Node:</strong> ${e($json.failed_node)}</p>          <p><strong>Error Message:</strong></p>         <div style=\"background:#fef2f2;padding:15px;border-radius:8px;white-space:pre-wrap;\">           ${e($json.error_message)}         </div>          <p><strong>Time:</strong> ${e($json.error_time)}</p>         <p><strong>Execution:</strong> ${e($json.execution_url)}</p>          <p style=\"color:#64748b;font-size:13px;\">           Please review the failed execution in n8n.         </p>       </div>      </div>   </div>`; })() }}",
        "options": {}
      },
