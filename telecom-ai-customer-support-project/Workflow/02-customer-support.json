    {
      "parameters": {
        "jsCode": "\n// 1. Get retrieved knowledge from Supabase\nconst results = $input.all();\n\nconst context = results\n  .map(item =>\n    item.json.document?.pageContent ??\n    item.json.pageContent ??\n    ''\n  )\n  .filter(text => text.trim() !== '')\n  .join('\\n\\n---\\n\\n');\n\n// 2. Get conversation history\nconst conversation = $('Prepare Chat History').first().json;\n\n// 3. Return one item for the AI\nreturn [{\n  json: {\n    conversation_id: conversation.conversation_id,\n    chat_id: conversation.chat_id,\n    question: conversation.question,\n    history: conversation.history,\n    context: context\n  }\n}];\n"
      },
