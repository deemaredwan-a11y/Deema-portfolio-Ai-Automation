    {
      "parameters": {
        "subject": "={{ `Telecom Support | Ticket #${$('Save Support Ticket').first().json.id} | Human Escalation` }}",
        "message": "=\n{{ (() => {\n  const customer = $('Edit Fields').first().json;\n  const conversation = $('Prepare Chat History').first().json;\n\n  const escapeHtml = (value) => String(value ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n\n  const history = escapeHtml(conversation.history || 'لا يوجد سجل سابق');\n\n  return `\n  <div dir=\"rtl\" style=\"background:#f3f6fa;padding:25px;font-family:Arial,Tahoma,sans-serif;color:#172b4d;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:650px;margin:auto;background:#fff;border-radius:12px;overflow:hidden;\">\n      <tr>\n        <td style=\"background:#17365d;padding:25px;color:white;\">\n          <h2 style=\"margin:0;\">طلب تدخل موظف دعم</h2>\n          <p style=\"margin:8px 0 0;color:#d2e3f7;\">\n            Telecom AI Customer Support\n          </p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:25px;\">\n          <div style=\"background:#fff3dc;color:#865500;padding:12px;border-radius:6px;\">\n            الحالة: تحتاج إلى متابعة بشرية\n          </div>\n\n          <h3>معلومات العميل</h3>\n          <p><strong>الاسم:</strong> ${escapeHtml(customer.user_name)}</p>\n          <p><strong>القناة:</strong> Telegram</p>\n          <p><strong>معرّف المحادثة:</strong> ${escapeHtml(conversation.conversation_id)}</p>\n\n          <h3>الاستفسار الحالي</h3>\n          <div style=\"background:#f3f6fa;padding:15px;border-radius:8px;white-space:pre-wrap;\">\n            ${escapeHtml(conversation.question)}\n          </div>\n\n          <h3>سجل المحادثة</h3>\n          <div style=\"background:#f8fafc;border:1px solid #dce3ec;padding:16px;border-radius:8px;white-space:pre-wrap;line-height:1.9;\">\n            ${history}\n          </div>\n\n          <p style=\"font-size:13px;color:#64748b;margin-top:25px;\">\n            يرجى مراجعة المحادثة ومتابعة طلب العميل وفق إجراءات فريق الدعم.\n          </p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"background:#edf2f7;padding:15px;text-align:center;font-size:12px;color:#64748b;\">\n          Telecom AI Support — Automated Escalation\n        </td>\n      </tr>\n    </table>\n  </div>`;\n})() }}\n",
        "options": {}
      },
