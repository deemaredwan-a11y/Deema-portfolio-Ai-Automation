      "parameters": {
        "jsCode": "\nconst messages = $input.all()\n  .map(item => item.json)\n  .filter(m => m.sender && m.content)\n  .sort((a, b) =>\n    new Date(a.created_at) - new Date(b.created_at)\n  );\n\nconst current = $('Prepare Conversation').first().json;\nconst question = String(current.user_message ?? '').trim();\n\nconst history = messages\n  .map(m => `${m.sender === 'customer' ? 'العميل' : 'المساعد'}: ${m.content}`)\n  .join('\\n');\n\n// Get the previous customer message\nconst previousMessages = messages.filter(m =>\n  m.sender === 'customer' &&\n  m.telegram_message_id !== Number(current.message_id)\n);\n\nconst previousQuestion = previousMessages.length\n  ? previousMessages[previousMessages.length - 1].content.trim()\n  : '';\n\n// Detect follow-up questions\nconst isFollowUp = /^(طيب|طب|وهل|هل|وكم|كم مدتها|قديش|وبالنسبة|وماذا|يعني)/i.test(question)\n  || /(صلاحيتها|تتجدد|بتتجدد|نفس الباقة|هذه الباقة|هالباقة)/i.test(question);\n\n// Prepare a contextual search query\nconst search_query = isFollowUp && previousQuestion\n  ? `السؤال السابق: ${previousQuestion}\\nسؤال المتابعة: ${question}`\n  : question;\n\nreturn [{\n  json: {\n    conversation_id: current.conversation_id,\n    chat_id: current.chat_id,\n    question,\n    history,\n    search_query\n  }\n}];\n"
      },
